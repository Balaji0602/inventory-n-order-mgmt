# System environments
ENV=development
DEBUG=true
PROJECT_NAME="Inventory & Order Management System"

# Database Configuration
# Local SQLite default (FastAPI will create this file locally automatically)
DATABASE_URL=sqlite:///./inventory_order.db

# In Production (Render/PostgreSQL), set this to the actual URL:
# DATABASE_URL=postgresql://db_user:password@host:port/database_name?sslmode=require

# CORS Permissions (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
